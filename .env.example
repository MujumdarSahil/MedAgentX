# MedAgentX Environment Variables — Example
# Copy this file to .env and fill in real values before running the server.
# Never commit .env with real secrets to version control.

# ──────────────────────────────────────────────────────────────────────────────
# LLM Providers
# ──────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ──────────────────────────────────────────────────────────────────────────────
# API / JWT
# ──────────────────────────────────────────────────────────────────────────────
# CHANGE THIS in production — any random 32+ char string
JWT_SECRET=medagentx_secret_key_change_in_production

# ──────────────────────────────────────────────────────────────────────────────
# Langfuse Self-Hosted Observability
# See docker-compose.langfuse.yml and docs/observability.md for full setup guide.
# ──────────────────────────────────────────────────────────────────────────────

# Public key generated inside the Langfuse UI after first login.
# Settings → API Keys → Create new key → copy the pk-lf-... value.
LANGFUSE_PUBLIC_KEY=pk-lf-changeme

# Secret key — keep this confidential; never expose in client-side code.
LANGFUSE_SECRET_KEY=sk-lf-changeme

# URL of your Langfuse server.  Default: local Docker deployment.
# For a remote / production instance use: https://langfuse.yourhospital.internal
LANGFUSE_HOST=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────────
# Langfuse Docker Compose Secrets
# Only needed if you are running docker-compose.langfuse.yml locally.
# ──────────────────────────────────────────────────────────────────────────────

# Postgres password for the local Langfuse Postgres container.
LANGFUSE_POSTGRES_PASSWORD=langfuse_local_pw

# ClickHouse password for the local ClickHouse container.
LANGFUSE_CLICKHOUSE_PASSWORD=langfuse_ch_local_pw

# NextAuth / session secrets — generate with: python -c "import secrets; print(secrets.token_hex(32))"
LANGFUSE_SALT=changeme-32-char-salt-string-here!
LANGFUSE_NEXTAUTH_SECRET=changeme-32-char-nextauth-secret!

# Bootstrap admin user for the local Langfuse instance.
LANGFUSE_ADMIN_EMAIL=admin@medagentx.local
LANGFUSE_ADMIN_NAME=MedAgentX Admin
LANGFUSE_ADMIN_PASSWORD=changeme-admin-pw

# ──────────────────────────────────────────────────────────────────────────────
# Optional: OTel BatchSpanProcessor tuning
# Uncomment and adjust only if you observe span-export lag or queue overflow.
# ──────────────────────────────────────────────────────────────────────────────
# OTEL_BSP_MAX_QUEUE_SIZE=2048
# OTEL_BSP_EXPORT_TIMEOUT=30000
# OTEL_BSP_SCHEDULE_DELAY=5000

# ──────────────────────────────────────────────────────────────────────────────
# Evaluation mode (expose /api/v1/analyze and /api/agents/{id}/reset endpoints)
# Set to "true" ONLY in local/evaluation environments; NEVER in production.
# ──────────────────────────────────────────────────────────────────────────────
# EVAL_MODE=true
