  {
    "scenario_id": "DET-001",
    "category": "state_transition_concurrency",
    "workflow": "crf_transition",
    "input": {
      "initial_state": "AI_SUGGESTED",
      "concurrent_events": [
        {"event": "DOCTOR_VALIDATED", "user": "Dr. A"},
        {"event": "DOCTOR_OVERRIDDEN", "user": "Dr. B"}
      ]
    },
    "expected_output_deterministic": true,
    "verification_method": "exact_state_match",
    "description": "Concurrent submission of validation and override events. The state machine must resolve deterministically, prioritizing the first processed or raising a serialization collision exception."
  },
